# Copia este archivo a ".env" y cambia los valores. NUNCA subas ".env" al repositorio.

# ---- Base de datos ----
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# ---- Backend ----
# Secreto JWT (mínimo 32 caracteres, aleatorio)
LABCONTROL_JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres-0123456789
# Dirección pública donde se abre la aplicación (se usa en los enlaces de los correos)
LABCONTROL_APP_URL=http://localhost
# Los datos iniciales los carga backend/db/03_datos_iniciales.sql; el backend no necesita crearlos.
LABCONTROL_SEED=false
LABCONTROL_SEED_HISTORIAL=false

# ---- Correo (códigos de registro y respaldo de los avisos) ----
# Gmail: smtp.gmail.com, puerto 587, tu correo y una «contraseña de aplicación» de 16 caracteres.
# Vacío = no se envían correos: el código aparece en la consola del backend.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Avisos de novedades ----
LABCONTROL_ALERTAS_DESTINO=u20232215593@usco.edu.co
# Token compartido entre el backend y el flujo de n8n (credencial Header Auth «X-LabControl-Token»)
N8N_WEBHOOK_TOKEN=cambia-este-token-largo-y-aleatorio
# En docker-compose.prod.yml ya apunta a n8n; en local: http://localhost:5678/webhook/labcontrol-novedades
# N8N_WEBHOOK_URL=
# Clave con la que n8n cifra sus credenciales (aleatoria; no la cambies después)
N8N_ENCRYPTION_KEY=cambia-esta-clave-de-cifrado-de-n8n
